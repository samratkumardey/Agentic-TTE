  "time_zero": {
    "anchor_event": "First time systolic blood pressure <90 mmHg for >30 min or catecholamines required to maintain systolic pressure >90 mmHg, combined with signs of impaired organ perfusion and arterial lactate >3 mmol/l",
    "offset": null,
    "rationale": "Time zero is defined as the moment when all inclusion criteria for cardiogenic shock are met, including hemodynamic instability, signs of organ hypoperfusion, and elevated lactate. This aligns with the trial's eligibility criteria and ensures treatment assignment occurs at the point of shock onset to avoid immortal time bias.",
    "origin": "agent",
    "evidence": "Inclusion criteria: Cardiogenic shock complicating AMI (STEMI or NSTEMI) plus obligatory: Planned revascularization (PCI or alternatively CABG); Systolic blood pressure <90 mmHg >30 min or catecholamines required to maintain pressure >90 mmHg during Systole; Signs of impaired organ perfusion with at least one of the following criteria a) Altered mental Status, b) Cold, clammy skin and extremities, c) Oliguria with urine output <30 ml/h; Arterial lactate >3 mmol/l"
  },
