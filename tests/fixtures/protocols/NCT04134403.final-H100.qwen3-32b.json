  "time_zero": {
    "anchor_event": "first time vasopressors and lactate > 2 mmol/L coincide during the ICU stay",
    "offset": null,
    "rationale": "Time zero is defined as the first moment when both vasopressor use and lactate > 2 mmol/L occur, as these are the defining criteria for septic shock under SEPSIS-3 and the point at which randomization becomes possible. No grace period is specified in the protocol.",
    "origin": "agent",
    "evidence": "Patients eligible for inclusion must be admitted with septic shock (as defined by SEPSIS-3) requiring vasopressors to maintain MAP ≥ 65 AND serum lactate level >2 mmol/L after adequate fluid resuscitation (generally recognized at 30 ml/kg crystalloid unless contraindicated as deemed by treating clinician) within the first three hours."
  },
